# Application Settings
PROJECT_NAME="Email Open Alert API"
API_V1_STR="/api/v1"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
BASE_URL="http://localhost:8000"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","*"]

# Database Configuration (REQUIRED — no default fallback)
# For PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
# For SQLite (local dev only): sqlite+aiosqlite:///./email_alerts.db
DATABASE_URL="sqlite+aiosqlite:///./email_alerts.db"

# Redis Configuration (optional — disabled by default)
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=False

# Alerts Configuration
ALERT_ON_FIRST_OPEN_ONLY=False

# Email Sending (optional)
BREVO_API_KEY=
